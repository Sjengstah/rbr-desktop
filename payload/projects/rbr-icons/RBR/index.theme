[Icon Theme]
Name=RBR
Comment=F1 RBR-style icons; everything else comes from kora and Breeze
Inherits=kora,breeze-dark,breeze,hicolor
Example=folder
DisplayDepth=32
Directories=scalable/places,scalable/devices,scalable/apps,scalable/categories,scalable/mimetypes,scalable/actions

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Places

[scalable/devices]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Devices

[scalable/apps]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[scalable/categories]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Categories

[scalable/mimetypes]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/actions]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Actions
